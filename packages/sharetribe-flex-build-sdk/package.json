{
  "name": "sharetribe-flex-build-sdk",
  "version": "1.17.1",
  "description": "SDK for building and managing Sharetribe Flex transaction processes",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:cjs && node scripts/fixup-dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json"
  },
  "keywords": [
    "sharetribe",
    "flex",
    "sdk",
    "marketplace",
    "transaction-process",
    "build-api"
  ],
  "author": "",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sharetribe-community/sharetribe-cli",
    "directory": "packages/sharetribe-flex-build-sdk"
  },
  "homepage": "https://github.com/sharetribe-community/sharetribe-cli/tree/master/packages/sharetribe-flex-build-sdk",
  "dependencies": {
    "jsedn": "^0.4.1",
    "transit-js": "^0.8.874"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.16"
  },
  "module": "./dist/esm/index.js"
}
